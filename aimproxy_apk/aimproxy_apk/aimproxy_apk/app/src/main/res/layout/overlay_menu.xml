<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AimProxy"
            android:textColor="#F3F3FF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnMin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#A78BFA"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap copies command → paste in chat"
        android:textColor="#8B8BA0"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Aim"
        android:textColor="#C4B5FD"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnSoft"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_btn"
        android:gravity="center"
        android:text=".aim soft"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnSnap"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_btn_dark"
        android:gravity="center"
        android:text=".aim snap"
        android:textColor="#F3F3FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnOff"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_btn_dark"
        android:gravity="center"
        android:text=".aim off"
        android:textColor="#F3F3FF"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Friends"
        android:textColor="#C4B5FD"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlayFriends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="(empty)"
        android:textColor="#8B8BA0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_dark"
        android:gravity="center"
        android:text="Close overlay"
        android:textColor="#F87171"
        android:textSize="13sp" />
</LinearLayout>
