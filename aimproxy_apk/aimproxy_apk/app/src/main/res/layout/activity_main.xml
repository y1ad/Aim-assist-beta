<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- Sidebar -->
    <LinearLayout
        android:layout_width="86dp"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="AP"
            android:textColor="@color/accent2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="#22FFFFFF" />

        <TextView
            android:id="@+id/navHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Home"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:background="@color/sidebar_sel" />

        <TextView
            android:id="@+id/navList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="List"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navMisc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Misc"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Content -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AimProxy"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Better tools. More control."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@color/card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Proxy host" android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/txtHost" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="fi11.bot-hosting.cloud"
                        android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="Port"
                        android:textColor="@color/muted" android:textSize="11sp" />
                    <TextView android:id="@+id/txtPort" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="26283"
                        android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/accent"
                    android:text="Open floating menu" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyHost"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Copy address" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyPort"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Copy port" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="In-game chat: .aim soft | .aim snap | .aim off\n.friend add Name | .friend list | .help"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </ScrollView>

        <!-- LIST (friends) -->
        <LinearLayout
            android:id="@+id/pageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User List"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Friends ignored by aim (like NovaClient list)."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Enter username...">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputFriend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFriend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent"
                    android:text="+ Add" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Added Users (0/100)"
                android:textColor="@color/text"
                android:textStyle="bold"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFriends"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearFriends"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear list" />
        </LinearLayout>

        
        <!-- MISC -->
        <ScrollView
            android:id="@+id/pageMisc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Misc"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toggles copy in-game commands for the Go proxy."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <!-- Aim card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@color/card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Aim Assist" android:textColor="@color/text" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Control aim mode on the proxy."
                        android:textColor="@color/muted" android:textSize="11sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Soft aim" android:textColor="@color/text" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Smooth tracking" android:textColor="@color/muted" android:textSize="11sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swSoft" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Snap aim" android:textColor="@color/text" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Instant look" android:textColor="@color/muted" android:textSize="11sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swSnap" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Aim enabled" android:textColor="@color/text" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Master on/off" android:textColor="@color/muted" android:textSize="11sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swAimOn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Tools card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tools" android:textColor="@color/text" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Helpers for this app."
                        android:textColor="@color/muted" android:textSize="11sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Floating menu" android:textColor="@color/text" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Overlay while in Minecraft" android:textColor="@color/muted" android:textSize="11sp" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMiscOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent"
                            android:text="Open"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Copy status cmd" android:textColor="@color/text" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=".aim status" android:textColor="@color/muted" android:textSize="11sp" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStatus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copy"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMiscHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Switch copies command → paste in Minecraft chat."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
</FrameLayout>
</LinearLayout>
